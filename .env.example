# Copy to `.env` in the repo root. Wrangler, Vitest, and Vite all read this file locally.
# Never commit `.env`.

# --- Auth & security ---
JWT_SECRET=
TURNSTILE_SECRET=
PII_ENCRYPTION_KEY=

# --- Didit KYC ---
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_SESSION_CREATE_URL=https://verification.didit.me/v3/session/

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_BASE_URL=https://sandbox.plaid.com
PLAID_SANDBOX_INSTITUTION=ins_109508

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- Loan / risk tuning ---
LOAN_FLAT_INTEREST_RATE=0.05
LOAN_UPFRONT_THRESHOLD=5000
LOAN_UPFRONT_PCT=0.05
RISK_SCORE_THRESHOLD=50

# --- Frontend (Vite) ---
VITE_TURNSTILE_TOKEN=XXXX.DUMMY.TOKEN.XXXX
# Pages production: Worker API URL (include /api). Omit locally — Vite proxies /api.
# VITE_API_BASE_URL=https://microloans-platform.<account>.workers.dev/api

# Optional, local only: "true" enables /api/demo shortcuts (mark bank/ID done). Never set in production.
# DEMO_MODE=true
